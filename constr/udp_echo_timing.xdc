# Timing constraints for examples/udp_echo on the Arty A7-100T (pins: arty_a7_100_pins.xdc +
# arty_a7_100_pins_tx.xdc; async FIFO pointer CDC: async_fifo.xdc, read scoped to
# async_fifo). Same as rx_stats_timing.xdc plus the MII transmit side.

# --- Clocks -------------------------------------------------------------------------
create_clock -name sys_clk_pin -period 10.000 -waveform {0 5} [get_ports CLK100MHZ]
# PHY receive clock, 25 MHz at 100 Mb/s (802.3 clause 22). The core clock and the
# 25 MHz reference are generated by the MMCM and derived automatically.
create_clock -name eth_rx_clk -period 40.000 [get_ports eth_rx_clk]
# PHY transmit clock, 25 MHz at 100 Mb/s, an input from the PHY (802.3 clause 22.2.2.1).
create_clock -name eth_tx_clk -period 40.000 [get_ports eth_tx_clk]
# The 25 MHz reference leaves through an ODDR; describe the forwarded clock at the pin.
create_generated_clock -name eth_ref_clk_out -divide_by 1 \
    -source [get_pins u_clk/u_oddr_ref/C] [get_ports eth_ref_clk]

# --- MII receive inputs ----------------------------------------------------------
# TI DP83848 datasheet SNLS250E (Apr 2015), T2.5.2: RX_CLK to RXD[3:0], RX_DV, RX_ER
# delay 10 ns min, 30 ns max at 100 Mb/s. Sampled on the next rising edge of rx_clk.
# Board trace delays are neglected (short, matched; a few hundred ps).
set mii_in [get_ports {eth_rxd[*] eth_rx_dv eth_rxerr}]
set_input_delay -clock eth_rx_clk -max 30.000 $mii_in
set_input_delay -clock eth_rx_clk -min 10.000 $mii_in
set_property IOB TRUE [get_cells -hier -filter {NAME =~ *u_mii_rx/rxd_q_reg*}]
set_property IOB TRUE [get_cells -hier -filter {NAME =~ *u_mii_rx/dv_q_reg}]
set_property IOB TRUE [get_cells -hier -filter {NAME =~ *u_mii_rx/er_q_reg}]

# --- MII transmit outputs -------------------------------------------------------------
# TI DP83848 datasheet SNLS250E (Apr 2015), 100 Mb/s MII transmit timing:
#   T2.4.2 TXD[3:0], TX_EN setup to TX_CLK 10 ns min; T2.4.3 hold from TX_CLK 0 ns min.
# mii_tx launches from IOB flops on a rising edge of TX_CLK (after the clock enters the
# FPGA and its buffer); the PHY captures on the next rising edge at its own pin.
# Board trace delays are neglected (short, matched; a few hundred ps).
set mii_out [get_ports {eth_txd[*] eth_tx_en}]
set_output_delay -clock eth_tx_clk -max 10.000 $mii_out
set_output_delay -clock eth_tx_clk -min 0.000 $mii_out
set_property IOB TRUE [get_cells -hier -filter {NAME =~ *u_mii_tx/mii_txd_o_reg*}]
set_property IOB TRUE [get_cells -hier -filter {NAME =~ *u_mii_tx/mii_tx_en_o_reg}]

# --- Clock-domain crossings (listed in examples/udp_echo/README.md) ------------------
# 1. async FIFO Gray pointers: set_max_delay -datapath_only in async_fifo.xdc.
# 2. Reset requests into reset_sync: level signals into an ASYNC_REG chain.
set_false_path -to [get_cells -hier -filter {NAME =~ *u_rst_*/sync_q_reg[0]}]
# 3. eth_tx underrun toggle (tx_clk -> core): a level into an ASYNC_REG chain; it changes
#    at most once per frame, so only its skew needs bounding, not its latency.
set_max_delay -datapath_only -from [get_cells -hier -filter {NAME =~ *u_eth_tx/underrun_tgl_q_reg}] \
    -to [get_cells -hier -filter {NAME =~ *u_eth_tx/underrun_sync_q_reg[0]}] 8.000

# --- Static or slow board I/O --------------------------------------------------------
# Button, LEDs, UART (115200 baud, bit time 8.7 us) and PHY reset/MDC strap levels carry
# no timing relationship worth constraining.
set_false_path -from [get_ports ck_rst]
# MDIO (mdio_link_mon): MDC <= 2.5 MHz; the design drives MDIO 200 ns before the PHY's
# MDC edge and samples it 380 ns after, through a 2-flop synchronizer, so the
# protocol, not STA, sets these margins.
set_false_path -from [get_ports eth_mdio]
set_false_path -to [get_ports {led[*] uart_rxd_out eth_rstn eth_mdc eth_mdio}]

# --- Configuration -------------------------------------------------------------------
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
set_property BITSTREAM.CONFIG.SPI_BUSWIDTH 4 [current_design]
